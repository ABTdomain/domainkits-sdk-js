{
	"compilerOptions": {
		"strict": true,
		"module": "node16",
		"moduleResolution": "node16",
		"target": "es2022",
		"lib": ["es2023", "dom"],
		"types": ["node"],
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*"]
}
